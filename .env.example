# CyberAgent AI Configuration Template

APP_NAME=CyberAgent AI
APP_ENV=development
DEBUG=true

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL (matches compose.yaml)
DATABASE_URL=postgresql://cyberagent:local_dev_password@localhost:5433/cyberagent_db
POSTGRES_USER=cyberagent
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=cyberagent_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# LLM provider (configured later)
LLM_PROVIDER=openai
OPENAI_API_KEY=

# ML model path
MODEL_PATH=models/attack_detector.joblib

# Logging
LOG_LEVEL=INFO